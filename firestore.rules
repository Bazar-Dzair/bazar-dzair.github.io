rules_version = '2';

// =====================================================================
// Bazar Dzair — Firestore Security Rules
// انسخ هذا الملف كاملاً إلى Firebase Console > Firestore > Rules ثم انشر.
// =====================================================================
// المنطق:
//   - المتجر (index.html / product.html) يعمل بدون تسجيل دخول ويقرأ من
//     المنتجات والتصنيفات والإعدادات → يجب أن تكون القراءة عامة.
//   - لوحة التحكم (admin.html) تسجل دخولًا وتكتب المنتجات والتصنيفات
//     والإعدادات والطلبات → الكتابة تكون للمستخدم المسجل فقط.
//   - الطلبات: يكتبها الزبون من صفحة المنتج (reader عام)، ويردها الأدمن.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // المنتجات — تُعرض لأي زائر والمتجر يقرأها بدون تسجيل.
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // التصنيفات — يحتاجها المتجر لعرض التصنيفات والأقسام.
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // الإعدادات — يقرأها المتجر (التوصيل، الاسم، التذييل) ويرها الأدمن.
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الطلبات — ينشئها الزبون (public create)، ويرها ويديرها الأدمن فقط.
    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

  }
}