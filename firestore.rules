rules_version = '2';

// =====================================================================
// Bazar Dzair — Firestore Security Rules (نسخة معززة v2)
// انسخ هذا الملف كاملاً إلى Firebase Console > Firestore > Rules ثم انشر.
//
// ⚠️ قبل النشر: بدّل القيمة 'GOBngnCP2eMTLZrJpf72GOmXvvO2' بـ UID حساب الأدمن الحقيقي.
//    كيفية الحصول عليه: Firebase Console → Authentication → Users →
//    عمود "User UID" لحسابك (وليس الإيميل).
//    استخدام UID أكثر أمانًا من الإيميل لأنه غير قابل للتخمين ولا يكشف
//    عنوان تسجيل الدخول الحقيقي في حال تسريب الكود.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // فقط صاحب هذا الـ UID يُعتبر أدمن — وليس أي حساب Firebase مسجل دخول.
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'GOBngnCP2eMTLZrJpf72GOmXvvO2';
    }

    // المنتجات — تُعرض لأي زائر، الكتابة للأدمن فقط.
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // التصنيفات — تُعرض لأي زائر، الكتابة للأدمن فقط.
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // التقييمات — تُنشأ حصرًا عبر Cloudflare Worker (مسار /submit-review) بصلاحيات Service Account،
    // وذلك فقط لمشتري لديه رمز تقييم صالح لطلب «مكتملة» (تقييم موثّق، لمرة واحدة). لا يوجد إنشاء
    // من المتصفح إطلاقًا. التقييم يُحفظ دائمًا بحالة approved == false ولا يظهر للزبائن إلا بعد
    // موافقة الأدمن. القراءة العامة تقتصر على التقييمات المنشورة؛ الأدمن وحده يقرأ/ينشر/يحذف أي تقييم.
    // isValidReview() لم تعد مستعملة (مرجع موثّق لنفس شروط الـ Worker، مثل isValidOrder).
    function isValidReview(d) {
      return
        d.keys().hasOnly(['productId','productName','authorName','ratingValue','text','approved','createdAt']) &&
        d.keys().hasAll(['productId','authorName','ratingValue','text','approved','createdAt']) &&
        // التاريخ يضعه الخادم فقط (serverTimestamp)
        d.createdAt == request.time &&
        d.approved == false &&
        d.productId is string && d.productId.size() > 0 && d.productId.size() < 200 &&
        exists(/databases/$(database)/documents/products/$(d.productId)) &&
        d.authorName is string && d.authorName.size() >= 2 && d.authorName.size() <= 60 &&
        d.text is string && d.text.size() >= 3 && d.text.size() <= 600 &&
        d.ratingValue is int && d.ratingValue >= 1 && d.ratingValue <= 5 &&
        (!('productName' in d) || (d.productName is string && d.productName.size() < 200));
    }
    match /reviews/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // الإعدادات — كل مستند settings/{id} قراءته عامة (اسم المتجر، الشعار،
    // أسعار التوصيل...)، ما عدا settings/email الذي يحتوي بيانات SMTP
    // الحساسة (smtpHost/smtpUser/smtpPassword) والذي يبقى Admin-only حتى
    // في القراءة. الكتابة دائمًا Admin فقط.
    match /settings/{id} {
      allow read: if id != 'email' || isAdmin();
      allow write: if isAdmin();
    }

    // ✅ الطلبات — إنشاء الطلب يتم حصرًا عبر Cloudflare Worker (مسار /create-order) الذي
    // يعمل بصلاحيات Service Account (تتجاوز هذه القواعد أصلاً). لهذا السبب لا يقدر أي
    // متصفح/سكربت الكتابة مباشرة في Firestore: هذا شرط أساسي لعمل حظر الـ IP، لأن
    // عنوان IP لا يراه إلا الـ Worker (رأس CF-Connecting-IP) ولا توجد أي طريقة
    // لفحصه داخل Security Rules. لو بقي الإنشاء المباشر مسموحًا، لكفى المزعج أن يتجاوز
    // موقعك ويكتب في Firestore مباشرة ليتفادى الحظر بالكامل.
    // الأدمن وحده يقرأ ويعدّل ويحذف الطلبات (ويقدر ينشئ يدويًا من لوحة التحكم إن احتاج).
    match /orders/{id} {
      allow create, read, update, delete: if isAdmin();
    }

    // ⚠️ أرقام الهواتف المحظورة — كانت هذه القاعدة ناقصة تمامًا (لا يوجد أي match
    // لهذا الـ collection)، فكانت قاعدة الرفض الافتراضي في نهاية الملف تمنع لوحة
    // التحكم (admin.html: bazarLoadBlockedPhones/blockPhone/unblockPhone) من قراءة
    // أو كتابة أي رقم محظور رغم تسجيل دخول الأدمن — يعمل الـ Worker فقط لأنه يستخدم
    // Service Account الذي يتجاوز Security Rules أصلاً.
    // كل وثيقة تحمل (اختياريًا): reason، blockedBy، blockedAt، expiresAt (غيابه = حظر دائم)،
    // status ('lifted' = مرفوع)، liftedAt، liftedBy، attempts، lastAttemptAt، lastAttemptIp.
    // عدّاد attempts يزيده الـ Worker (Service Account) عند كل محاولة طلب بعد الحظر.
    match /blockedPhones/{phone} {
      allow read, write: if isAdmin();
    }

    // 🚫 عناوين IP المحظورة — معرّف الوثيقة = مفتاح الـ IP (IPv4 كما هو، أو أول 64 بت
    // من IPv6 على شكل v6-2001-db8-1-2). الأدمن وحده يقرأ ويكتب من لوحة التحكم
    // (admin.html)، والـ Worker يقرأها بصلاحيات Service Account قبل قبول أي طلب. لا
    // قراءة عامة إطلاقًا حتى لا يعرف المزعج أن IP الخاص به محظور من هذه القائمة.
    match /blockedIps/{key} {
      allow read, write: if isAdmin();
    }

    // 🛡️ نظام كشف الإساءة (Fraud / Abuse) — يكتبه الـ Worker حصرًا بصلاحيات Service Account،
    // فلا يوجد أي create/write من المتصفح هنا إطلاقًا (لو سُمح، لأمكن لأي زائر تزوير الإنذارات
    // أو إغراق اللوحة). الأدمن يقرأ الإنذارات ويعدّل حالتها (seen/resolved) ويحذفها.
    match /fraudAlerts/{id} {
      allow read, update, delete: if isAdmin();
    }

    // إشارات كل مفتاح (ip / phone / device / addr): آخر الأحداث فقط. للأدمن قراءة وحذف
    // (تنظيف يدوي)؛ الكتابة للـ Worker فقط. الحقل expireAt يسمح بتفعيل TTL Policy اختياريًا.
    match /fraudSignals/{id} {
      allow read, delete: if isAdmin();
    }

    // isValidOrder() لم تعد مستعملة في أي قاعدة (إنشاء الطلب صار عبر الـ Worker فقط)،
    // لكنها تبقى مرجعًا موثّقًا لنفس الشروط التي يعيد الـ Worker (create-order.js)
    // تطبيقها يدويًا قبل الكتابة بصلاحيات Service Account. لا تحذفها: أي تعديل على شروط
    // الطلب يجب أن يُطبَّق في الاثنين معًا.
    function isValidOrder(d) {
      return
        // الحقول المسموحة فقط — أي حقل إضافي (adminNotes، role، isAdmin...) يرفض الطلب
        // (الحقول الأخيرة ip/ipKey/country/deviceId/addrKey/risk* يضيفها الـ Worker وحده)
        d.keys().hasOnly(['customerName','customerPhone','wilaya','address','product','productId','quantity','price','shipping','deliveryType','shippingCompany','total','variant','status','createdAt','ip','ipKey','country','deviceId','addrKey','riskLevel','riskScore','riskFlags']) &&
        // ✅ productId أصبح إجباريًا (وليس اختياريًا) لسد ثغرة كانت تسمح بتجاوز
        // التحقق من السعر الحقيقي عبر إرسال طلب بدون productId.
        d.keys().hasAll(['customerName','customerPhone','wilaya','address','product','productId','quantity','price','total','status']) &&

        // status يجب أن يكون قيمة البداية الثابتة فقط — لا يقدر الزبون يبعث طلب "مؤكد" مباشرة
        d.status == 'جديد' &&

        // نصوص أساسية بحدود طول منطقية (تمنع payloads ضخمة أو حقول فارغة)
        d.customerName is string && d.customerName.size() > 0 && d.customerName.size() < 100 &&
        d.customerPhone is string && d.customerPhone.matches('^0[5-7][0-9]{8}$') &&
        // 🚫 رقم محظور من طرف الأدمن (collection blockedPhones) لا يقدر يسجّل طلب جديد.
        !exists(/databases/$(database)/documents/blockedPhones/$(d.customerPhone)) &&
        d.wilaya is string && d.wilaya.size() > 0 && d.wilaya.size() < 100 &&
        d.address is string && d.address.size() > 0 && d.address.size() < 300 &&
        d.product is string && d.product.size() > 0 && d.product.size() < 200 &&
        d.productId is string && d.productId.size() > 0 && d.productId.size() < 200 &&
        (!('deliveryType' in d) || (d.deliveryType is string && d.deliveryType.size() < 50)) &&
        (!('shippingCompany' in d) || (d.shippingCompany is string && d.shippingCompany.size() < 100)) &&
        (!('variant' in d) || (d.variant is string && d.variant.size() < 200)) &&

        // أرقام منطقية — يمنع كمية سالبة أو صفر أو كمية ضخمة (بوت)، وسعر/مجموع سالب
        d.quantity is int && d.quantity > 0 && d.quantity <= 50 &&
        d.price is number && d.price >= 0 &&
        d.total is number && d.total >= 0 &&
        (!('shipping' in d) || (d.shipping is number && d.shipping >= 0)) &&

        // ✅ حماية من التلاعب بالمجموع: total يجب أن يساوي حسابيًا price×quantity + shipping
        d.total == (d.price * d.quantity) + (('shipping' in d) ? d.shipping : 0) &&

        // ✅ حماية من التلاعب بالسعر: productId إجباري الآن، ويجب أن يطابق price
        // السعر الحقيقي المخزّن فعليًا في المنتج — هذا يمنع مهاجم يتواصل مباشرة مع
        // Firestore (بدون المرور بواجهة الموقع) من إرسال سعر مزيف أو منتج وهمي غير موجود.
        get(/databases/$(database)/documents/products/$(d.productId)).data.price == d.price;
    }

    // 👁️ زوار الموقع (إحصائية يومية) — مستند واحد لكل يوم، معرّفه YYYY-MM-DD (مثلاً 2026-09-25)،
    // يحتوي فقط على count (عدد الزيارات) و updatedAt. الكتابة مسموحة للجميع لكن بشكل ضيّق جدًا:
    // إما إنشاء مستند جديد بقيمة count == 1 بالضبط، أو زيادة count بمقدار 1 بالضبط في كل مرة —
    // أي قيمة أخرى (تصفير، قفزة كبيرة، حقل إضافي) مرفوضة تلقائيًا. لا قراءة عامة إطلاقًا حتى لا
    // يرى أي زائر عدد زوار الموقع؛ الأدمن وحده يقرأها (ويحذفها عند الحاجة) من لوحة التحكم.
    match /visits/{date} {
      allow read, delete: if isAdmin();
      allow create: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['count','updatedAt'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count','updatedAt'])
                    && request.resource.data.count == resource.data.count + 1;
    }

    // 🖱️ مشاهدات المنتجات — مستند واحد لكل منتج، معرّفه = firestoreId الخاص بالمنتج،
    // يحتوي فقط على count (عدد مرات فتح صفحة هذا المنتج) و updatedAt و name (اسم المنتج
    // وقت آخر مشاهدة، لعرضه في لوحة التحكم دون الحاجة لقراءة وثيقة المنتج بشكل إضافي).
    // نفس منطق visits/{date} أعلاه بالضبط: الكتابة العامة مسموحة لكن بشكل ضيّق جدًا —
    // إما إنشاء مستند جديد بقيمة count == 1 بالضبط، أو زيادة count بمقدار 1 بالضبط في كل
    // مرة؛ أي قيمة أخرى (تصفير، قفزة كبيرة، حقل إضافي) مرفوضة تلقائيًا. لا قراءة عامة
    // إطلاقًا حتى لا يرى أي زائر عدد مشاهدات منتج ما؛ الأدمن وحده يقرأها من لوحة التحكم.
    match /productViews/{productId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['count','updatedAt','name'])
                    && request.resource.data.count == 1
                    && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() < 200));
      allow update: if request.resource.data.keys().hasOnly(['count','updatedAt','name'])
                    && request.resource.data.count == resource.data.count + 1
                    && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() < 200));
    }

    // Deny-by-default صريح: أي collection أو مستند غير معروف/غير مذكور أعلاه ممنوع تمامًا.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

